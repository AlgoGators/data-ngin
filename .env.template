# Description: Template for environment variables
# Usage: Copy this file to .env in project root and fill in the values

# Databento API key
DATABENTO_API_KEY=databento-api-key

# Tiingo API keys (equities pipeline).
# The fetcher collects EVERY env var whose name starts with TIINGO_API_KEY and
# rotates across them, so adding capacity is purely an .env edit -- no code change.
# Each free-tier key allows ~50 requests/hour; the universe is ~570 symbols, so
# ~12 keys are needed to fetch it all in one daily run (ceil(symbols / 50)).
# IMPORTANT: only put ACTUAL API keys under the TIINGO_API_KEY* prefix. A non-key
# var like TIINGO_API_KEY_EXPIRY would be treated as a (bad) token and waste a slot.
TIINGO_API_KEY=tiingo-api-key
TIINGO_API_KEY_2=tiingo-api-key-2
# TIINGO_API_KEY_3=...
# ... add as many as you have, up to the count you need.

# AlgoGators API key
ALGOGATORS_API_KEY=algogators-api-key

# Database credentials
DB_HOST=db-host
DB_PORT=db-port
DB_USER=db-user
DB_PASSWORD=db-password
DB_NAME=db-name

# Database API gateway (the `api` service in docker-compose.yml).
# THREE passwords, one per Postgres login: api_service_ro, api_service_rw and
# api_service_all. The service chooses the login from the caller's key, so all
# three must be set -- see migrations/003_api_gateway_roles.sql for why a single
# shared login would be escalatable. Generate each with `openssl rand -base64 32`
# and apply it with ALTER ROLE; the migration ships a placeholder password.
API_DB_HOST=api-db-host
API_DB_PORT=5432
API_DB_NAME=api-db-name
API_DB_PASSWORD_RO=api-service-ro-password
API_DB_PASSWORD_RW=api-service-rw-password
API_DB_PASSWORD_ALL=api-service-all-password

# Airflow metadata DB connection (docker-compose.yml, all three services).
# docker-compose auto-loads .env from the project root and substitutes ${AIRFLOW_DB_CONN}
# into the compose file at parse time -- keep this out of docker-compose.yml itself.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>?options=-csearch_path%3Dairflow_metadata
AIRFLOW_DB_CONN=postgresql+psycopg2://airflow-db-user:airflow-db-password@airflow-db-host:5432/algo_data?options=-csearch_path%3Dairflow_metadata