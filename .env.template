# Description: Template for environment variables
# Usage: Copy this file to .env in project root and fill in the values

# Databento API key
DATABENTO_API_KEY=databento-api-key

# AlgoGators API key
ALGOGATORS_API_KEY=algogators-api-key

# Database credentials
DB_HOST=db-host
DB_PORT=db-port
DB_USER=db-user
DB_PASSWORD=db-password
DB_NAME=db-name

# DB connection pool (src/infrastructure/repository/ohlcv_repository.py) -- optional.
# DB_POOL_MIN_CONN=1
# DB_POOL_MAX_CONN=10

# DATA_NGIN_STALENESS_THRESHOLD_DAYS=1  # dags/data_pipeline_dag.py's check_staleness task

# GraphQL query API (src/api/server.py) -- all optional, defaults shown.
# DATA_NGIN_CONFIG_PATH=src/config/config.yaml
# DATA_NGIN_API_KEY=                          # unset = auth disabled (local dev only)
# DATA_NGIN_API_RATE_LIMIT_MAX=60
# DATA_NGIN_API_RATE_LIMIT_WINDOW_SECONDS=60